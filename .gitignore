# Dependencies
node_modules/
bun.lock

# Next.js build output (webapp/). Unanchored so it matches at any depth.
# Build artifacts, not personal data, so this rule is deliberately NOT in
# security_guards.py's REQUIRED_IGNORE_RULES.
.next/
# TypeScript incremental build cache - regenerated by every `tsc`/`next build`,
# so it shows up as an untracked file after any webapp work. Same rationale as
# .next/: build artifact, deliberately not a REQUIRED_IGNORE_RULE.
*.tsbuildinfo

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Compiled documents
*.pdf
*.aux
*.log
*.out
*.synctex.gz
*.fls
*.fdb_latexmk

# Personal data (never commit these)
# These use the depth-independent `**/` form because personal files live under
# profiles/<id>/ and archived ones under profiles/archived/<id>/ - a repo-rooted
# pattern silently fails to match either. The OpenFonts negation further down
# deliberately stays rooted: it guards only the shared root fixture.
**/salary_data.json
# Match at any depth: the job-scraper skill resolves `job_scraper/` relative to
# its own directory, so these land at .claude/skills/job-scraper/job_scraper/*.
# A rooted `job_scraper/...` pattern silently fails to match them.
**/job_scraper/seen_jobs.json
**/job_scraper/notion_sync.json
**/job_scraper/*.md
*_BehavioralReport.pdf
linkedin_Profile.pdf

# Which profile is active: fork-local state, not shared config. The committed
# .active-profile.example seeds it, so a fresh clone starts on _scaffold and
# must switch deliberately.
.active-profile

# Command locks. /scrape and /apply write profiles/<id>/.lock while they run so
# a mid-run profile switch cannot repoint paths under them; removed when done.
# `profiles/**/` (not `profiles/*/`) so archived profiles, which sit one level
# deeper at profiles/archived/<id>/, are covered by the same rule.
profiles/**/.lock

# A profile's own markdown IS the personal data: CLAUDE.md holds the candidate's
# identity and address, 01/02 their work history, 04/05/07 their evaluation and
# interview material, search-queries.md their job-search strategy. The rules
# above cover generated artifacts (CVs, PDFs, scraper state) but said nothing
# about these, leaving them untracked-but-committable - one `git add .` from
# being published.
#
# profiles/_scaffold/ is re-included because it is the shared placeholder
# template every new profile is copied from, and CI checks it for placeholder
# integrity. Archived profiles are deliberately NOT re-included: they are
# somebody's real data that merely stopped being active.
profiles/**/*.md
!profiles/_scaffold/**/*.md

# Personal photos and signatures
*.jpg
*.jpeg
*.png
!cover_letters/OpenFonts/fonts/**

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Memory files (Claude Code user-specific)
.claude/projects/
.claude/settings.local.json

# Session handoffs and worktrees - working notes that name real profile data
# (candidate names, real run costs, etc), never meant to be committed
.claude/handoffs/
.claude/worktrees/

# Skills lock (auto-generated)
skills-lock.json

# Personal application output files (generated by /apply — do not share)
# Each negation names ONE exact path. They must never be widened to `**/`:
# a profile's own cv/main_example.tex is that person's real master CV, and a
# `**/` negation would commit it. Only the root fixture and the scaffold copy
# are placeholder files safe to track.
**/cv/main_*.tex
!cv/main_example.tex
!profiles/_scaffold/cv/main_example.tex
**/cv/*.txt
**/cover_letters/cover_*.tex
**/cover_letters/Cover_*.tex
!cover_letters/cover_example.tex
!profiles/_scaffold/cover_letters/cover_example.tex

# Per-profile LaTeX assets. `profile_manager.py create` copies cover.cls and
# OpenFonts/ out of the root cover_letters/ fixture so xelatex resolves them as
# siblings of the .tex it is compiling. Ignoring the copies keeps exactly one
# set of the ~30 font files in git - the root one.
# `profiles/**/` (not `profiles/*/`) so archiving a profile, which moves it down
# to profiles/archived/<id>/, does not un-ignore its whole font tree.
profiles/**/cover_letters/cover.cls
profiles/**/cover_letters/OpenFonts/

# documents/ subfolder contents are personal — only README and folder structure are tracked
**/documents/cv/**
**/documents/linkedin/**
**/documents/diplomas/**
**/documents/references/**
**/documents/applications/**
**/documents/postings/**
# Interview prep and experience records: these name the employers applied to,
# quote what was submitted, and set out the candidate's weak points.
**/documents/interview/**
# Two exact paths, not `**/`, for the same reason as the LaTeX negations below:
# a `**/` negation would let a real profile's directory skeleton be committed,
# publishing the profile id. Only the root fixture and the scaffold are shared.
!documents/**/.gitkeep
!profiles/_scaffold/documents/**/.gitkeep

# Personal job search tracking
**/job_search_tracker.csv

# Gmail sync state (message IDs, subjects - personal data)
**/gmail_sync/

# Generated reports (personal output from /html-report)
**/reports/

# Upskill reports (personal output)
**/upskill/*.md

# Agent skills: track the source, ignore only deps and logs.
# (A blanket `.agents/` ignore silently drops the job-search CLI skills from the repo.)
.agents/**/node_modules/
.agents/**/*.log
.agents/usage/

# Brainstorm mockups (superpowers visual companion) - never ship
.superpowers/

# Local email-report automation (personal, machine-specific wrapper + logs)
scripts/
logs/
